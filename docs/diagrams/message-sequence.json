    {
      "from": "process",
      "to": "entry",
      "y": 702,
      "label": "reply, route, tool_calls",
      "variant": "return"
    },
    {
      "from": "entry",
      "to": "meta",
      "y": 737,
      "label": "send reply (3 tries)",
      "variant": "emphasis",
      "note": "3 tries, 2000 ms apart"
    },
    {
      "from": "entry",
      "to": "db",
      "y": 777,
      "label": "set replied_at"
    }
