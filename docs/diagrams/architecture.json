  "cards": [
    {
      "dot": "cyan",
      "title": "Message path",
      "items": [
        "Meta signs every webhook; the tunnel forwards one path",
        "One process-message run per change: dedupe, limit, triage, route",
        "Tools take the phone from the workflow, never from the model"
      ]
    },
    {
      "dot": "rose",
      "title": "When something fails",
      "items": [
        "A Jev failure sends the message straight to the agent",
        "Tool and agent failures email the team in plain text",
        "error-handler emails the team when any workflow fails"
      ]
    },
    {
      "dot": "slate",
      "title": "Other triggers",
      "items": [
        "retention-cleanup prunes old messages and memory daily at 03:00",
        "dev-harness takes POST /webhook/dev with X-Dev-Token",
        "The harness path never matches the tunnel allowlist"
      ]
    }
  ]
