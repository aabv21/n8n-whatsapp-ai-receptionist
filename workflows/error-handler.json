{
  "id": "cmbErrorHandler1",
  "name": "Error handler",
  "description": null,
  "nodes": [
    {
      "id": "20000000-0000-4000-8000-000000000001",
      "name": "Catch workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -120,
        180
      ],
      "parameters": {}
    },
    {
      "id": "20000000-0000-4000-8000-000000000002",
      "name": "Load context",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [
        160,
        180
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "cmbLoadContext01"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "schema": [],
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        }
      }
    },
    {
      "id": "20000000-0000-4000-8000-000000000003",
      "name": "Compose error email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        420,
        180
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "20000000-0000-4000-8000-0000000a0004",
              "name": "subject",
              "type": "string",
              "value": "=[Cumbident demo] Workflow failed: {{ $('Catch workflow error').item.json.workflow.name }}"
            },
            {
              "id": "20000000-0000-4000-8000-0000000a0005",
              "name": "body",
              "type": "string",
              "value": "=Failed node: {{ $('Catch workflow error').item.json.execution.lastNodeExecuted }}\nError: {{ $('Catch workflow error').item.json.execution.error.message }}\nExecution: {{ $('Catch workflow error').item.json.execution.url }}\nTime: {{ $now.setZone('America/Bogota').toFormat('yyyy-LL-dd HH:mm') }} America/Bogota"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "20000000-0000-4000-8000-000000000006",
      "name": "Send failure email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        680,
        180
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.config.team_email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "cmbCredGmail0001",
          "name": "Gmail"
        }
      }
    },
    {
      "id": "20000000-0000-4000-8000-000000000007",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -160,
        -40
      ],
      "parameters": {
        "width": 1080,
        "height": 160,
        "content": "## Error handler\nRuns whenever a workflow with errorWorkflow set to this one fails. Loads context for config.team_email, composes a plain-text alert, and emails it. This workflow has no errorWorkflow of its own, so a failure here does not loop back into itself."
      }
    }
  ],
  "connections": {
    "Catch workflow error": {
      "main": [
        [
          {
            "node": "Load context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load context": {
      "main": [
        [
          {
            "node": "Compose error email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compose error email": {
      "main": [
        [
          {
            "node": "Send failure email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Bogota",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "meta": null,
  "nodeGroups": [],
  "sourceWorkflowId": null,
  "tags": [],
  "versionMetadata": {
    "name": null,
    "description": null
  }
}
