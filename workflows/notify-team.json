      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT EXISTS (SELECT 1 FROM inbound_messages WHERE phone = $1 AND received_at > now() - make_interval(mins => $2) AND triage->>'team_alerted' = 'true' AND ($3::text IS DISTINCT FROM 'emergency' OR triage->>'alerted_reason' = 'emergency')) AS alerted",
        "options": {
          "queryReplacement": "={{ $('Receive alert request').first().json.phone }},{{ $('Load context').first().json.config.limits.alert_cooldown_minutes }},{{ $('Receive alert request').first().json.reason }}"
        }
      },
