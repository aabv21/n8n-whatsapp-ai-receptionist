      "name": "Check alert cooldown",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        1140,
        340
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
