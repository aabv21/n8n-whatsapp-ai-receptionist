{
  "id": "cmbRetentionJob1",
  "name": "Retention cleanup",
  "description": null,
  "nodes": [
    {
      "id": "b0000000-0000-4000-8000-000000000001",
      "name": "Run daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        -160,
        140
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 3,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000002",
      "name": "Run on demand",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        -160,
        360
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000003",
      "name": "Load context",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [
        120,
        250
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "cmbLoadContext01"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "schema": [],
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        }
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000004",
      "name": "Delete expired chat memory",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        380,
        250
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM n8n_chat_histories h WHERE NOT EXISTS (SELECT 1 FROM inbound_messages m WHERE (h.session_id = m.phone OR h.session_id = 'test:' || m.phone) AND m.received_at >= now() - make_interval(days => $1))",
        "options": {
          "queryReplacement": "={{ $('Load context').item.json.config.limits.retention_days }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "cmbCredAppDb0001",
          "name": "App DB"
        }
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000005",
      "name": "Delete expired messages",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        660,
        250
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM inbound_messages WHERE received_at < now() - make_interval(days => $1)",
        "options": {
          "queryReplacement": "={{ $('Load context').item.json.config.limits.retention_days }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "cmbCredAppDb0001",
          "name": "App DB"
        }
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000006",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -140
      ],
      "parameters": {
        "width": 1300,
        "height": 220,
        "content": "## Retention cleanup\nRuns daily at 03:00 America/Bogota; an Execute Workflow Trigger lets the dev harness's `retention` target run it too, with no input. Both triggers feed the same Load context step, which supplies `config.limits.retention_days`. Chat memory is deleted first: an n8n_chat_histories row is judged by whether inbound_messages still has a row for that session's phone (bare for WhatsApp, `test:`-prefixed for the test channel) inside the retention window, so memory is pruned while the messages it's judged against are still there; inbound_messages itself is pruned last, by received_at. Both deletes set Always Output Data, because a bare DELETE with no RETURNING clause reports zero rows affected as zero items, which would otherwise stop the branch and leave an Execute Workflow Trigger caller with nothing returned."
      }
    }
  ],
  "connections": {
    "Run daily": {
      "main": [
        [
          {
            "node": "Load context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run on demand": {
      "main": [
        [
          {
            "node": "Load context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load context": {
      "main": [
        [
          {
            "node": "Delete expired chat memory",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delete expired chat memory": {
      "main": [
        [
          {
            "node": "Delete expired messages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Bogota",
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "cmbErrorHandler1"
  },
  "meta": null,
  "nodeGroups": [],
  "sourceWorkflowId": null,
  "tags": [],
  "versionMetadata": {
    "name": null,
    "description": null
  }
}
