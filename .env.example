# Postgres bootstrap superuser; only used to create the roles below. Generate
# secrets in this file with: openssl rand -hex 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# n8n's own database role
N8N_DB_USER=n8n
N8N_DB_PASSWORD=

# The app's database role, used by workflows and scripts
APP_DB_USER=app
APP_DB_PASSWORD=

# n8n instance
N8N_ENCRYPTION_KEY=
N8N_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/ # set to https://<NGROK_DOMAIN>/ when using the tunnel

# Dev harness
DEV_HARNESS_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=

# TypeSafe
TYPESAFE_API_KEY=

# Google OAuth (shared by the Calendar, Sheets, and Gmail credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Meta (WhatsApp)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=

# ngrok
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
